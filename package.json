{
  "name": "hearth-tracker",
  "version": "0.3.0",
  "description": "A Hearthstone deck tracker with overlays, match history and stats.",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "native": "cargo build --release --manifest-path native/capture/Cargo.toml && node -e \"require('fs').copyFileSync('native/capture/target/release/capture.dll', 'native/capture.node')\"",
    "dev": "npm run native && electron-vite dev",
    "build": "npm run native && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "dev.hearthtracker.app",
    "productName": "Hearth Tracker",
    "files": [
      "out/**/*",
      "native/capture.node"
    ],
    "win": {
      "target": "nsis"
    },
    "asarUnpack": [
      "native/capture.node"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "koffi": "^3.3.8",
    "tesseract.js": "^7.0.0"
  }
}
